# Copy the website ID from the Umami website tracking-code screen.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# First-party proxy for Umami Cloud. Change this only when self-hosting Umami.
NEXT_PUBLIC_UMAMI_SCRIPT_SRC=/telemetry/script.js

# Optional consent-gated performance analytics. Find this in Cloudflare:
# Analytics & Logs -> Web Analytics -> Manage site -> JS snippet.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=

# Optional consent-gated browser error monitoring. Paste the Sentry Loader
# Script URL from Project Settings -> Client Keys (DSN) -> JavaScript Loader.
NEXT_PUBLIC_SENTRY_LOADER_URL=

# Optional server-side GitHub token for a higher public API rate limit.
GITHUB_TOKEN=

# Optional. Workers AI uses the AI binding in wrangler.jsonc and needs no API key.
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
